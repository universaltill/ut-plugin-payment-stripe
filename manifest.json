{
  "id": "com.universaltill.payment-stripe",
  "name": "Stripe Card Payments",
  "version": "1.10.2",
  "description": "Take card payments through Stripe. Authorization runs BEFORE the sale completes: the till asks Stripe to charge the amount and only finishes the sale if Stripe approves. Set your Stripe SECRET key (sk_...) in the settings. For card-present payments, also set a Stripe Terminal reader id (stripe_reader_id) — the till drives the reader (Reader S700 / WisePOS E, or a test simulated reader). With no reader id it runs an online/demo charge; in test mode amounts ending .13 decline. Card refunds are wired too: refunding a Stripe sale on the till refunds the original charge automatically.",
  "author": "Universal Till",
  "website": "https://universaltill.com",
  "canonical_type": "payment",
  "runtime": "wasm",
  "device_arch": "any",
  "min_pos_version": "0.36.3",
  "permissions": [
    "pos.tender",
    "events:receive",
    "view:shop",
    "net:api.stripe.com",
    "device:tap_to_pay",
    "net:payment_broker",
    "storage",
    "blob:own"
  ],
  "locales": [
    "en-US"
  ],
  "entries": [
    {
      "type": "payment",
      "key": "stripe",
      "label": "Card (Stripe)",
      "sort_order": 4,
      "trigger_event": "payment.stripe.requested"
    },
    {
      "type": "payment",
      "key": "stripe_tap",
      "label": "payment_stripe.tap.label",
      "sort_order": 3,
      "trigger_event": "payment.stripe_tap.requested",
      "config": {
        "tap": true,
        "provider": "stripe"
      }
    }
  ],
  "settings": [
    {
      "key": "stripe_secret_key",
      "default_value": "",
      "scope": "global",
      "type": "secret",
      "label": "payment_stripe.secret_key.label",
      "help": "payment_stripe.secret_key.help"
    },
    {
      "key": "currency",
      "default_value": "auto",
      "scope": "global",
      "label": "payment_stripe.currency.label",
      "help": "payment_stripe.currency.help",
      "type": "choice",
      "options": [
        {
          "value": "auto",
          "label": "payment_stripe.currency.opt.auto"
        },
        {
          "value": "aed",
          "label": "payment_stripe.currency.opt.aed"
        },
        {
          "value": "aud",
          "label": "payment_stripe.currency.opt.aud"
        },
        {
          "value": "brl",
          "label": "payment_stripe.currency.opt.brl"
        },
        {
          "value": "cad",
          "label": "payment_stripe.currency.opt.cad"
        },
        {
          "value": "chf",
          "label": "payment_stripe.currency.opt.chf"
        },
        {
          "value": "czk",
          "label": "payment_stripe.currency.opt.czk"
        },
        {
          "value": "dkk",
          "label": "payment_stripe.currency.opt.dkk"
        },
        {
          "value": "eur",
          "label": "payment_stripe.currency.opt.eur"
        },
        {
          "value": "gbp",
          "label": "payment_stripe.currency.opt.gbp"
        },
        {
          "value": "mxn",
          "label": "payment_stripe.currency.opt.mxn"
        },
        {
          "value": "myr",
          "label": "payment_stripe.currency.opt.myr"
        },
        {
          "value": "nok",
          "label": "payment_stripe.currency.opt.nok"
        },
        {
          "value": "pln",
          "label": "payment_stripe.currency.opt.pln"
        },
        {
          "value": "ron",
          "label": "payment_stripe.currency.opt.ron"
        },
        {
          "value": "sek",
          "label": "payment_stripe.currency.opt.sek"
        },
        {
          "value": "try",
          "label": "payment_stripe.currency.opt.try"
        },
        {
          "value": "usd",
          "label": "payment_stripe.currency.opt.usd"
        }
      ]
    },
    {
      "key": "stripe_reader_id",
      "default_value": "",
      "scope": "register",
      "label": "payment_stripe.reader_id.label",
      "help": "payment_stripe.reader_id.help"
    }
  ],
  "entrypoint": "./bin/plugin.wasm",
  "hooks": [
    {
      "event": "payment.stripe.authorize",
      "action": "stripe.authorize"
    },
    {
      "event": "payment.stripe.requested",
      "action": "stripe.settled"
    },
    {
      "event": "payment.stripe.refund",
      "action": "stripe.refund"
    },
    {
      "event": "payment.stripe.readers",
      "action": "stripe.readers"
    },
    {
      "event": "payment.stripe_tap.authorize",
      "action": "stripe_tap.authorize"
    },
    {
      "event": "payment.stripe_tap.requested",
      "action": "stripe_tap.settled"
    },
    {
      "event": "payment.stripe_tap.refund",
      "action": "stripe_tap.refund"
    },
    {
      "event": "payment.stripe_tap.readers",
      "action": "stripe_tap.readers"
    }
  ],
  "views_used": [
    "shop.context.v2"
  ]
}
